classDiagram
    class DB {
        +sqlite3.Connection _conn
        +get_conn() Connection
        +tx() contextmanager
        +init_schema() None
        +apply_migrations() list~int~
        +close() None
    }
    class MigrateCLI {
        +run_migrate() dict
        +check() dict
        +rollback() None
        +backup() Path
        +infer_book_id(stem) str
        +infer_kind(name, content) str
        +infer_genre(name, content) str
    }
    class AssetIndex {
        +int ttl_seconds
        +dict _cache
        +float _cache_ts
        +list_assets(kind, genre, book_id, offset, limit) dict
        +get_asset_detail(kind, asset_id) dict
        +get_overview() Overview
        +count_by_kind() dict
        +invalidate() None
    }
    class StateStore {
        +upsert_task(task) None
        +load_task(book_id) dict
        +save_state(state) None
        +load_state(book_id) dict
    }
    class GuiService {
        +get_overview() Overview
        +list_assets(kind, genre, book_id, offset, limit) dict
        +get_asset_detail(kind, asset_id) dict
        +list_reports() list
        +get_status(book_id) dict
        +get_stats() dict
    }
    class Asset {
        +str asset_key
