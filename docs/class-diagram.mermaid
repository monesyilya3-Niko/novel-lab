        +str genre
        +int size
        +float mtime
    }
    class Book {
        +str book_id
        +str title
        +str genre
        +str status
    }
    class Report {
        +str report_key
        +str type
        +str book_id
        +str path
        +int char_count
    }
    class AnalysisTask {
        +str book_id
        +str status
        +str cursor
        +dict batch_state
        +int state_revision
    }
