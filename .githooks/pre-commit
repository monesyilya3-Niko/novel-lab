#!/bin/sh
# novel-lab 提交前守卫（pre-commit）
# ---------------------------------------------------------------------------
# 作用：提交前先跑 ruff check（CI 每个分支都跑，本地不跑就会把 lint 失败留到 CI），
#       再运行全量回归测试（python run_tests.py）。红测试一律阻止提交，
#       避免把失败状态固化进版本库。本机没有 ruff 时只警告、不拦。
#       测试通过后，再对本次**暂存**的 assets/*.json 逐个跑 schema 校验
#       （python scripts/validate.py）。REJECT（返回码 1）阻止提交，WARN（2）仅提示。
#
# 启用（新克隆的人只需执行一次）：
#   git config core.hooksPath .githooks
#
# 绕过（仅在确知要临时跳过时使用）：
#   git commit --no-verify
#
# 指定解释器（可选，优先级最高）：
#   NOVEL_LAB_PYTHON=/path/to/python git commit -m "..."
#
# 纯 POSIX sh + 标准库，无第三方依赖（铁律三）。
# ---------------------------------------------------------------------------
set -u

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(pwd)
cd "$REPO_ROOT" || {
    echo "[pre-commit] 无法进入仓库根目录：$REPO_ROOT" >&2
    exit 1
}

# --- 解释器解析：健壮降级，绝不因「指定解释器缺失」而崩溃 -------------------
resolve_python() {
    # 1) 显式环境变量优先
    if [ -n "${NOVEL_LAB_PYTHON:-}" ]; then
        if [ -x "$NOVEL_LAB_PYTHON" ]; then
            printf '%s\n' "$NOVEL_LAB_PYTHON"
            return 0
        fi
        echo "[pre-commit] 警告：NOVEL_LAB_PYTHON=$NOVEL_LAB_PYTHON 不存在或不可执行，继续尝试其它候选。" >&2
    fi

    # 2) 项目约定解释器 / 项目内 venv（存在才用）
    for cand in \
        "C:/Users/monesy/.niko/binaries/python/versions/3.13.12/python.exe" \
        "$REPO_ROOT/.venv/Scripts/python.exe" \
        "$REPO_ROOT/.venv/bin/python" \
        "$REPO_ROOT/venv/Scripts/python.exe" \
        "$REPO_ROOT/venv/bin/python"
    do
        if [ -x "$cand" ]; then
            printf '%s\n' "$cand"
            return 0
        fi
    done

    # 3) 回退到 PATH（带警告，不静默）
    for name in python3 python; do
        if command -v "$name" >/dev/null 2>&1; then
            echo "[pre-commit] 警告：未找到项目约定解释器，回退到 PATH 的 $name。" >&2
            command -v "$name"
            return 0
        fi
    done

    return 1
}

if ! PYTHON=$(resolve_python); then
    echo "" >&2
    echo "============================================================" >&2
    echo "  [pre-commit] 未找到任何可用的 Python 解释器，无法运行测试。" >&2
    echo "  请安装 Python 到 PATH，或设置 NOVEL_LAB_PYTHON 指向解释器。" >&2
    echo "  临时绕过：git commit --no-verify" >&2
    echo "============================================================" >&2
    exit 1
fi

# --- ruff：CI 每个分支都跑 `ruff check .`，本地守卫不跑就会把 lint 失败留到 CI ----
# 2026-10-08 实测踩过一次：本地只跑测试就提交，推送后 ubuntu 三条腿同时红在 F401。
# ruff 缺失时只警告不拦（CI 仍是权威门禁），避免把"没装可选工具"变成"提交不了"。
run_ruff() {
    if command -v ruff >/dev/null 2>&1; then
        echo "[pre-commit] Lint：ruff check ."
        ruff check . && return 0
        return 1
    fi
    if "$PYTHON" -m ruff --version >/dev/null 2>&1; then
        echo "[pre-commit] Lint：$PYTHON -m ruff check ."
        "$PYTHON" -m ruff check . && return 0
        return 1
    fi
    echo "[pre-commit] 警告：本机没有 ruff，跳过 Lint（CI 仍会检查，可能推送后才发现）。" >&2
    echo "[pre-commit] 装一次即可：pip install ruff（CI 锁定的版本见 .github/workflows/ci.yml 的 RUFF_VERSION）。" >&2
    return 0
}

if ! run_ruff; then
    echo "" >&2
    echo "============================================================" >&2
    echo "  [pre-commit] Lint 未通过，提交已阻止。" >&2
    echo "  可自动修复的部分：ruff check . --fix" >&2
    echo "  确需临时绕过：git commit --no-verify" >&2
    echo "============================================================" >&2
    exit 1
fi

echo "[pre-commit] 解释器：$PYTHON"
echo "[pre-commit] 运行全量回归测试：python run_tests.py"
echo "[pre-commit] ------------------------------------------------------------"

"$PYTHON" run_tests.py
STATUS=$?

if [ "$STATUS" -eq 0 ]; then
    echo "[pre-commit] ------------------------------------------------------------"
    echo "[pre-commit] 测试通过，进入资产 schema 校验（仅暂存的 assets/*.json）。"

    # --- 资产 schema 校验：只查本次暂存的资产，无暂存资产则跳过 -----------------
    # 返回码约定（scripts/validate.py）：0=PASS，1=REJECT（阻止提交），2=WARN（仅提示）。
    # core.quotepath=false：git 默认把非 ASCII 文件名转义成 \346\232\256…，
    # 脚本拿转义串查文件必然「不存在」，导致中文资产（如「暮冬念春-*.json」）
    # 被静默跳过校验（2026-09-21 实测 4 个文件被跳过）。
    STAGED_ASSETS=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM -- 'assets/*.json' 2>/dev/null || true)

    if [ -z "$STAGED_ASSETS" ]; then
        echo "[pre-commit] 无变更资产，跳过 schema 校验。"
    else
        ASSET_TOTAL=0
        ASSET_FAILED=""
        ASSET_FAIL_COUNT=0

        OLD_IFS=$IFS
        IFS='
'
        for asset in $STAGED_ASSETS; do
            [ -n "$asset" ] || continue
            if [ ! -f "$asset" ]; then
                echo "[pre-commit] 跳过（工作区不存在）：$asset"
                continue
            fi

            ASSET_TOTAL=$((ASSET_TOTAL + 1))
            echo "[pre-commit] --- 校验 $asset"
            "$PYTHON" scripts/validate.py "$asset"
            ASSET_STATUS=$?

            case "$ASSET_STATUS" in
                0)
                    ;;
                2)
                    echo "[pre-commit] 警告：$asset 校验为 WARN（不阻止提交），建议人工复核。" >&2
                    ;;
                1)
                    echo "[pre-commit] 拒绝：$asset 不符合 schema。" >&2
                    ASSET_FAILED="$ASSET_FAILED
  - $asset"
                    ASSET_FAIL_COUNT=$((ASSET_FAIL_COUNT + 1))
                    ;;
                *)
                    echo "[pre-commit] 异常：$asset 校验脚本返回码 $ASSET_STATUS（视为失败）。" >&2
                    ASSET_FAILED="$ASSET_FAILED
  - $asset（校验脚本异常，返回码 $ASSET_STATUS）"
                    ASSET_FAIL_COUNT=$((ASSET_FAIL_COUNT + 1))
                    ;;
            esac
        done
        IFS=$OLD_IFS

        if [ "$ASSET_FAIL_COUNT" -gt 0 ]; then
            echo "" >&2
            echo "============================================================" >&2
            echo "  [pre-commit] 资产 schema 校验未通过，提交已阻止。" >&2
            echo "  不合规资产（$ASSET_FAIL_COUNT 个）：$ASSET_FAILED" >&2
            echo "  查看详情：python scripts/validate.py <资产路径>" >&2
            echo "  确需临时绕过：git commit --no-verify" >&2
            echo "============================================================" >&2
            exit 1
        fi

        echo "[pre-commit] 资产 schema 校验通过（$ASSET_TOTAL 个）。"
    fi

    echo "[pre-commit] ------------------------------------------------------------"
    echo "[pre-commit] 测试通过，允许提交。"
    exit 0
fi

echo "[pre-commit] ------------------------------------------------------------"
echo "" >&2
echo "============================================================" >&2
echo "  [pre-commit] 测试未通过，提交已阻止。" >&2
echo "  请先修复失败用例再提交。" >&2
echo "  确需临时绕过：git commit --no-verify" >&2
echo "============================================================" >&2
exit "$STATUS"
