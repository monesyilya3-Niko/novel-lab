{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "distilled.schema.json",
  "title": "多维蒸馏资产（distilled）",
  "description": "pass5 蒸馏产物的统一契约：把某个维度（voice-card / craft-card / structure-obs / commercial-obs）的多书规则聚合成一份带溯源与盲区记录的资产。distilled 自身不是 voice-card——它只是以 meta.dimension 标注自己蒸馏自哪个维度，故校验必须走本 schema，不得套用 voice-card 的强字段契约。",
  "type": "object",
  "required": ["meta", "rules", "blindspots", "stats"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "schema_version", "dimension", "genre", "source_books", "books_count"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "description": "蒸馏资产唯一 id，如 campus-redemption-voice-card-distilled" },
        "schema_version": { "type": "string", "description": "本契约版本，当前 1.0" },
        "dimension": {
          "type": "string",
          "enum": ["voice-card", "craft-card", "structure-obs", "commercial-obs"],
          "description": "蒸馏来源维度；rules[].dimension 必须与之完全一致（防跨维度混装）"
        },
        "genre": { "type": "string", "minLength": 2, "description": "题材 id（铁律一：蒸馏产物按题材隔离）" },
        "distilled_at": { "type": "string", "description": "蒸馏时间戳（ISO 8601，允许缺省）" },
        "source_books": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "参与聚合的书 id 列表"
        },
        "books_count": { "type": "integer", "minimum": 0, "description": "参与聚合的书数（应等于 source_books 长度）" }
      }
    },
    "rules": {
      "type": "array",
      "description": "蒸馏出的规则列表；允许为空数组（该维度未产出可聚合规则时）",
      "items": {
        "type": "object",
        "required": ["id", "dimension", "field", "kind", "books_count", "value",
                     "confidence", "conflict", "over_generalized", "blindspot_books"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "规则唯一 id" },
          "dimension": {
            "type": "string",
            "enum": ["voice-card", "craft-card", "structure-obs", "commercial-obs"],
            "description": "必须等于 meta.dimension"
          },
          "field": { "type": "string", "minLength": 1, "description": "被蒸馏的字段路径，如 narration.pov" },
          "kind": { "type": "string", "enum": ["hard", "soft"], "description": "hard=多书一致；soft=存在分歧或个性化" },
          "books_count": { "type": "integer", "minimum": 0, "description": "支持该规则的书数" },
          "value": { "description": "聚合后的值，类型随字段而定（字符串/数字/数组/对象/缺省 null 均合法）" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["book", "value"],
              "properties": {
                "book": { "type": "string" },
                "value": {}
              }
            },
            "description": "逐书原始值（溯源）"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "object" },
            "description": "逐书证据（章节/引文/置信度），不含原文长段"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "聚合置信度" },
          "conflict": { "type": "boolean", "description": "多书之间是否存在冲突" },
          "over_generalized": { "type": "boolean", "description": "是否被过度泛化（需人工复核）" },
          "blindspot_books": {
            "type": "array",
            "items": { "type": "string" },
            "description": "未覆盖到该字段的书 id 列表"
          }
        }
      }
    },
    "blindspots": {
      "type": "array",
      "description": "维度级盲区记录（字段缺失/无法判定）",
      "items": {
        "type": "object",
        "required": ["book", "dimension", "field", "note"],
        "properties": {
          "book": { "type": "string" },
          "dimension": { "type": "string", "enum": ["voice-card", "craft-card", "structure-obs", "commercial-obs"] },
          "field": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "聚合统计（键可缺省，不强制具体键，避免历史产物失配）",
      "properties": {
        "total_rules": { "type": "integer", "minimum": 0 },
        "hard_rules": { "type": "integer", "minimum": 0 },
        "soft_rules": { "type": "integer", "minimum": 0 },
        "personal_styles": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 },
        "blindspots": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
