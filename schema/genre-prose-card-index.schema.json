{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "genre-prose-card-index.schema.json",
  "title": "题材文风卡索引（genre-prose-card-index）",
  "description": "assets/genre-prose-card-index.json 的专用契约：题材中文名 → {id, file} 的查表索引。索引本身不是文风卡（不得走 voice-card 或 genre-prose-card 校验），只承担题材隔离的落库寻址职责。",
  "type": "object",
  "required": ["_count", "_description", "cards"],
  "properties": {
    "_count": {
      "type": "integer",
      "minimum": 0,
      "description": "卡片总数（应与 cards 条目数一致）"
    },
    "_description": {
      "type": "string",
      "description": "索引用途说明"
    },
    "cards": {
      "type": "object",
      "description": "题材中文名 → 卡片寻址信息",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "题材文风卡 id，如 genre-xianxia"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "落库文件名，如 genre-prose-card-genre-xianxia.json"
          }
        }
      }
    }
  }
}
