  "language_rules": {
    "iron_rules": [
      {
        "rule": "战斗与突破段多用短句与动词，避免长绵比喻堆叠。",
        "bad_example": "他体内那股力量仿佛沉睡了千年的远古巨龙终于苏醒一般缓缓涌动起来。",
        "good_example": "丹田一热。气感冲开第一道关。\n\n他睁眼。",
        "rationale": "升级流节奏靠短句爆发，长句易拖垮爽点。"
      },
      {
        "rule": "境界/功法名词全书一致，禁止同物异名。",
        "bad_example": "同一境界先后写作「炼气三层/练气三重/气海三阶」。",
        "good_example": "统一为「炼气三层」。",
        "rationale": "设定一致性硬门禁。"
      }
    ]
  },
