  "language_rules": {
    "iron_rules": [
      {
        "rule": "必须采用第三人称限知视角，男主内心后置。",
        "bad_example": "他想起童年被父亲锁在门外的那个雨夜，心里一阵绞痛。",
        "good_example": "他抬腕看表，又把手插回口袋。很久才说：没事。",
        "rationale": "样本全书以女主感知为限；男主创伤通过动作与转述显形，信息差是核心追读力。"
      },
      {
        "rule": "情绪峰值用短句或单句成段，禁止长句直陈情绪。",
        "bad_example": "一种难以名状的巨大悲伤与愤怒同时击中了她，让她几乎无法呼吸。",
        "good_example": "她愣住了。\n\n然后，笑了。",
        "rationale": "峰值章句长显著短于平叙；单句成段是该题材定格情绪的硬手法。"
      },
      {
        "rule": "情绪以体感与动作外化为主，禁止直陈情绪词堆砌。",
        "bad_example": "她很心动，非常伤心，极其愤怒。",
        "good_example": "喉咙发紧。手指发抖。她把药膏拧开，又拧回去。",
        "rationale": "样本情绪模式为混合式（体感+动作+环境投射）；直陈词是AI味重灾区。"
      },
      {
        "rule": "比喻与意象取材日常物件、天气物候与食物，禁止宏大比喻与古风口癖。",
        "bad_example": "她的灵魂像一只折翼的蝴蝶，在无尽的黑夜里坠落。",
        "good_example": "豆浆的热气扑在手背上，像有人轻轻握了一下。",
        "rationale": "样本意象域集中于校园物件、初霜/雪/梧桐、食物热气；宏大比喻破坏现实感。"
      }
    ],
